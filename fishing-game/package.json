{
  "name": "loon-lake-angler",
  "version": "1.0.0",
  "private": true,
  "description": "Loon Lake Angler: a realistic 3D fishing game that runs in the browser (three.js, WebGL).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs && node build.mjs --standalone",
    "build:artifact": "node build.mjs",
    "build:standalone": "node build.mjs --standalone",
    "shoot": "node tools/harness.mjs",
    "shoot:xr": "node tools/harness.mjs --xr"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "iwer": "2.5.0",
    "three": "0.170.0"
  },
  "license": "MIT"
}
